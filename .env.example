# ──────────────────────────────────────────────────────────────
# Student ID PDF System — Environment Variables
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/student_id_db?schema=public"

# ── Authentication ────────────────────────────────────────────
# Secret used to sign JWT tokens (min 32 characters, generate with `openssl rand -hex 32`)
JWT_SECRET="CHANGE_ME_generate_with_openssl_rand_hex_32"

# NextAuth.js secrets
NEXTAUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_hex_32"
NEXTAUTH_URL="http://localhost:3000"

# Secret used for signed URL HMAC tokens (falls back to NEXTAUTH_SECRET if unset)
# SIGNED_URL_SECRET=""

# ── Cloudinary (Image Storage) ────────────────────────────────
# If unset, the app falls back to local filesystem storage (dev only).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Secondary Cloudinary account for marketplace template storage (optional)
# TEMPLATE_CLOUDINARY_CLOUD_NAME=""
# TEMPLATE_CLOUDINARY_API_KEY=""
# TEMPLATE_CLOUDINARY_API_SECRET=""

# ── Upstash Redis (Rate Limiting) ─────────────────────────────
# If unset, rate limiting is disabled.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ── Stripe (Payments — optional) ──────────────────────────────
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# ── Cron Jobs ─────────────────────────────────────────────────
# Secret token to authenticate Vercel cron job requests
# CRON_SECRET=""

# ── Portal ────────────────────────────────────────────────────
# Public-facing URL for cardholder enrollment portal links
PORTAL_URL="http://localhost:3000"

# ── Observability ─────────────────────────────────────────────
# Sentry DSN for error monitoring (obtain from sentry.io project settings)
# NEXT_PUBLIC_SENTRY_DSN=""

# Set to "debug" | "info" | "warn" | "error" to control log verbosity
# LOG_LEVEL="info"

# Set to "true" to output JSON-formatted structured logs
# STRUCTURED_LOGGING="false"

# ── Build & Runtime ──────────────────────────────────────────
# NODE_ENV is set automatically; do not override in .env
# SKIP_ENV_VALIDATION="true"  # Set to skip env validation during builds
